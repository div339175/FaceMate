# Django
DJANGO_SECRET_KEY=change-me-for-production
DJANGO_DEBUG=true
DJANGO_ENABLE_DEMO_LOGIN=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.ngrok-free.app,.ngrok.io
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app

# Database mode
# Use sqlite for easiest laptop setup: DB_ENGINE=sqlite
# Use mysql only if MySQL is installed and configured on the machine.
DB_ENGINE=sqlite

# MySQL settings (only used when DB_ENGINE=mysql)
DB_NAME=facemate
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Production-only transport security. Enable these after HTTPS is configured.
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0

# Tune only after validating the recognition model with representative images.
FACE_MATCH_THRESHOLD=0.55
